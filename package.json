{
  "name": "strudel2wav",
  "version": "0.1.0",
  "description": "Render Strudel scripts to WAV files",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "test": "node build.mjs && node --test test/e2e.test.mjs",
    "prepare": "node build.mjs",
    "build:exe": "node build.mjs && node scripts/build-exe.mjs"
  },
  "keywords": [
    "strudel",
    "tidal",
    "audio",
    "wav"
  ],
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "superdough": "^1.3.0",
    "typescript": "^7.0.2"
  },
  "bin": {
    "strudel2wav": "dist/cli.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/cli.cjs",
    "README.md"
  ]
}
