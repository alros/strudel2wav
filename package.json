{
  "name": "strudel2wav",
  "version": "0.1.0",
  "description": "Render Strudel scripts to WAV files",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "test": "node build.mjs && node --test test/*.test.mjs",
    "prepare": "node build.mjs"
  },
  "keywords": [
    "strudel",
    "tidal",
    "audio",
    "wav"
  ],
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/webaudio": "^1.3.0",
    "superdough": "^1.3.0"
  },
  "bin": {
    "strudel2wav": "dist/cli.js"
  }
}
